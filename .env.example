# Public canonical site URL. Production always falls back to https://bethaacademy.co.ke
# if this is unset or points at localhost / preview hosts.
NEXT_PUBLIC_SITE_URL=https://bethaacademy.co.ke

# Optional Google Search Console HTML-tag verification token.
# Prefer Cloudflare DNS TXT verification for the Domain property.
GOOGLE_SITE_VERIFICATION=
